local function _removeESP(p)
    if _espObjects[p] then
        for _, obj in pairs(_espObjects[p]) do
            if type(obj) == "table" then
                for _, line in pairs(obj) do pcall(function() line:Remove() end) end
            else
                pcall(function() obj:Remove() end)
            end
        end
        _espObjects[p] = nil
    end
