local weatherParticleFolder = Instance.new("Folder")
weatherParticleFolder.Name = "WeatherParticleFolder"
weatherParticleFolder.Parent = ws

local function clearWeather()
    weatherParticleFolder:ClearAllChildren()
end

local function applyWeather(weatherType)
    clearWeather()
    getgenv().WorldConfig.Weather = weatherType
    
    if weatherType == "Snow" then
        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = "SnowEmitter"
        emitter.Texture = "rbxassetid://606917390"
        emitter.Rate = 200
        emitter.Speed = NumberRange.new(5, 10)
        emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.5)})
        emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.2)})
        emitter.Lifetime = NumberRange.new(5, 8)
        emitter.Acceleration = Vector3.new(0, -2, 0)
        emitter.VelocitySpread = 50
        
        local part = Instance.new("Part")
        part.Name = "SnowSpawner"
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 1
        part.CanCollide = false
        part.Anchored = true
        part.Parent = weatherParticleFolder
        
        emitter.Parent = part
        
        task.spawn(function()
            while getgenv().WorldConfig.Weather == "Snow" do
                local char = lplr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    part.Position = char.HumanoidRootPart.Position + Vector3.new(0, 30, 0)
                end
                task.wait(0.2)
            end
            part:Destroy()
        end)
        
    elseif weatherType == "Rain" then
        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = "RainEmitter"
        emitter.Texture = "rbxassetid://606917390"
        emitter.Rate = 500
        emitter.Speed = NumberRange.new(40, 60)
        emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.15)})
        emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0.4)})
        emitter.Lifetime = NumberRange.new(1, 1.5)
        emitter.Acceleration = Vector3.new(0, -50, 0)
        emitter.VelocitySpread = 10
        
        local part = Instance.new("Part")
        part.Name = "RainSpawner"
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 1
        part.CanCollide = false
        part.Anchored = true
        part.Parent = weatherParticleFolder
        
        emitter.Parent = part
        
        task.spawn(function()
            while getgenv().WorldConfig.Weather == "Rain" do
                local char = lplr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    part.Position = char.HumanoidRootPart.Position + Vector3.new(0, 35, 0)
                end
                task.wait(0.2)
            end
            part:Destroy()
        end)
    end
end

runS.Stepped:Connect(function()
    local char = lplr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    
    if hum then
        hum.WalkSpeed = 16 * getgenv().MovementConfig.WalkSpeed
    end

    if getgenv().MovementConfig.NoclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if getgenv().MovementConfig.FlyEnabled and hrp then
        local cam = ws.CurrentCamera
        local moveDir = Vector3.new()
        if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if uis:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        hrp.Velocity = moveDir * getgenv().MovementConfig.FlySpeed
        hrp.CFrame = hrp.CFrame + (hrp.Velocity * runS.Stepped:Wait())
    end
end)

