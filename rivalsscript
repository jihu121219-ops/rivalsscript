local function anim2track(asset_id)
    local objs = game:GetObjects(asset_id)
    for i = 1, #objs do
        if objs[i]:IsA("Animation") then
            return objs[i].AnimationId
        end
    end
    return asset_id
end

local activeEmoteTrack = nil

local function stopEmote()
    if activeEmoteTrack then
        pcall(function()
            activeEmoteTrack:Stop()
            activeEmoteTrack:Destroy()
        end)
        activeEmoteTrack = nil
    end
end

local function setupEmoteForCharacter(character)
    local Hum = character:WaitForChild("Humanoid", 5)
    if not Hum then return end
    
    local animid = getgenv().EmoteConfig.AnimationId
    if not animid:find("rbxassetid://") then
        animid = "rbxassetid://" .. animid
    end
    pcall(function()
        animid = anim2track(animid)
    end)
    
    local animation = Instance.new("Animation")
    animation.AnimationId = animid

    local function playAnim()
        if not getgenv().EmoteConfig.Enabled then 
            stopEmote()
            return 
        end
        local char = lplr.Character
        if not char or char ~= character then return end
        local humanoid = char:FindFirstChildWhichIsA("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        
        if activeEmoteTrack and activeEmoteTrack.IsPlaying then
            return
        end
        
        stopEmote()
        
        local success, anim = pcall(function()
            return humanoid:LoadAnimation(animation)
        end)
        if success and anim then
            activeEmoteTrack = anim
            anim.Priority = Enum.AnimationPriority.Action4
            anim:Play()
            anim:AdjustSpeed(getgenv().EmoteConfig.Speed)
            
            anim.Stopped:Connect(function()
                if getgenv().EmoteConfig.Enabled and lplr.Character == character then
                    task.spawn(playAnim)
                end
            end)
        end
    end

    playAnim()
end

